M=$(shell pwd)
AUDIO_ROOT=$(KERNEL_SRC)/$(M)

KBUILD_OPTIONS += CONFIG_ARCH_BENGAL=y
KBUILD_OPTIONS += CONFIG_TARGET_PROJECT_K7T=y
KBUILD_OPTIONS += CONFIG_SND_SOC_BENGAL=m
KBUILD_OPTIONS += MODNAME=audio_dlkm
KBUILD_OPTIONS += AUDIO_ROOT=$(AUDIO_ROOT)
KBUILD_OPTIONS += KCFLAGS=-DDEBUG

all: modules

clean:
	$(MAKE) -C $(KERNEL_SRC) M=$(M) clean

%:
	$(MAKE) -C $(KERNEL_SRC) M=$(M) $@ $(KBUILD_OPTIONS)
